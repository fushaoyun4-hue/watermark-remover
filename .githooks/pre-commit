#!/bin/bash
# ============================================================
# pre-commit hook — 纯 bash 自动修复格式问题
# 完全离线运行，无外部依赖
# ============================================================
set -e

REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null)
cd "$REPO_DIR"

echo "[pre-commit] 检查并自动修复格式问题..."

FIXED_FILES=""
HAS_UNFIXABLE=0

# ── 1. 检测并修复尾部空白 ──────────────────────────────────
while IFS= read -r FILE; do
    # 移除尾部空白（原位修改）
    sed -i 's/[[:space:]]*$//' "$FILE"
    FIXED_FILES="$FIXED_FILES $FILE"
done < <(grep -rl '[[:space:]]*$' \
    --include="*.kt" --include="*.kts" \
    --include="*.xml" --include="*.gradle" --include="*.gradle.kts" \
    --include="*.md" --include="*.yaml" --include="*.yml" --include="*.properties" \
    . 2>/dev/null || true)

# ── 2. 检测并修复 CRLF 行尾（统一为 LF）─────────────────────
CRLF_FILES=$(file -n -m - $(git diff --cached --name-only 2>/dev/null) 2>/dev/null | grep 'CRLF' | cut -d: -f1 || true)
if [ -n "$CRLF_FILES" ]; then
    for FILE in $CRLF_FILES; do
        if [ -f "$FILE" ]; then
            sed -i 's/\r$//' "$FILE"
            FIXED_FILES="$FIXED_FILES $FILE"
        fi
    done
fi

# ── 3. 检测冲突标记 ────────────────────────────────────────
CONFLICT_FILES=$(grep -rlE '^<<<<<<<|^=======$|^>>>>>>>' \
    --include="*.kt" --include="*.kts" --include="*.xml" \
    --include="*.java" --include="*.gradle" --include="*.gradle.kts" \
    . 2>/dev/null | head -10 || true)
if [ -n "$CONFLICT_FILES" ]; then
    echo ""
    echo "========================================"
    echo "⚠️  发现冲突标记，必须手动处理："
    echo ""
    echo "$CONFLICT_FILES"
    echo "========================================"
    echo "请打开这些文件，搜索 <<<<<< 手动解决冲突"
    echo "========================================"
    exit 1
fi

# ── 4. 检测大文件（>2MB 应使用 Git LFS）─────────────────────
BIG_FILES=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | while read F; do
    SIZE=$(wc -c < "$F" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt 2097152 ]; then
        echo "$F ($(( (SIZE + 1048575) / 1048576 ))MB)"
    fi
done)
if [ -n "$BIG_FILES" ]; then
    echo ""
    echo "========================================"
    echo "⚠️  以下文件超过 2MB，请使用 Git LFS："
    echo "$BIG_FILES"
    echo "========================================"
    echo "安装 LFS：git lfs install"
    echo "追踪大文件：git lfs track \"*.mp4\""
    echo "========================================"
    exit 1
fi

# ── 5. 暂存所有格式修复的文件（让本次 commit 包含修复）─────
# 注意：不要 amend！git commit 后运行 hook 时 amend 会和 ref lock 冲突
if [ -n "$FIXED_FILES" ]; then
    echo "[pre-commit] 发现格式修复，自动暂存..."
    # 对工作目录中已修改的文件（不在暂存区）追加暂存
    git diff --name-only 2>/dev/null | while read F; do
        [ -f "$F" ] && git add "$F" 2>/dev/null || true
    done

    # 如果还没有 commit（即首次 commit），工作目录的修复会包含在当前 commit 中
    # 如果已有 commit，修复会作为 unstaged changes 留下
    if ! git rev-parse HEAD >/dev/null 2>&1; then
        echo "[pre-commit] ✓ 格式修复已自动加入 commit"
    else
        echo "[pre-commit] ✓ 格式修复已暂存（请再 commit 一次）"
    fi
fi

echo "[pre-commit] ✓ 格式检查通过"
exit 0
